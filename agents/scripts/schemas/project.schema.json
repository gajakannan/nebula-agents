{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product instructions and validation checks v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "instructions", "checks"],
  "properties": {
    "version": {"const": 1},
    "instructions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "action", "stage", "event", "argv", "cwd", "timeout_seconds", "inputs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "action": {"type": "string"},
          "stage": {"type": "string"},
          "event": {"const": "before_stage_complete"},
          "argv": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "cwd": {"const": "product"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
          "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
